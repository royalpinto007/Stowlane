{
  "manifest_version": 3,
  "name": "Stowlane: Save and Restore Tabs",
  "version": "1.0.0",
  "description": "Close forty tabs without losing them. Stow a window into a named lane and bring it back later. No account, no network.",
  "permissions": ["tabs", "storage", "sidePanel"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": { "default_title": "Stowlane" },
  "side_panel": { "default_path": "sidepanel.html" },
  "commands": {
    "stow-window": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Stow this window's tabs into a new lane"
    }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
