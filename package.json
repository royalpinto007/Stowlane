{
  "name": "stowlane",
  "version": "1.0.0",
  "private": true,
  "description": "Close forty tabs without losing them. Local-only tab sessions, no account and no network.",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
